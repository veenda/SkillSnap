@page "/register"
@using System.ComponentModel.DataAnnotations
@using SkillSnap.Shared.Models
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IUserStateService UserStateService
@implements IDisposable

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primary fw-bold">Create an Account</h3>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger rounded-3">@errorMessage</div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success rounded-3">@successMessage</div>
                    }

                    @if (isUserAuthenticated)
                    {
                        <div class="alert alert-info rounded-3 text-center">
                            <h5>Welcome, @UserStateService.Email!</h5>
                            @if (!string.IsNullOrEmpty(UserStateService.Role))
                            {
                                <p class="mb-1">Role: <strong>@UserStateService.Role</strong></p>
                            }
                            @if (UserStateService.IsExpired())
                            {
                                <p class="text-warning small mb-2">⚠️ Your session has expired. Please login again.</p>
                            }
                            else if (UserStateService.ExpirationTime.HasValue)
                            {
                                <p class="small mb-3">Session expires: @UserStateService.ExpirationTime.Value.ToLocalTime()</p>
                            }
                            <button type="button" class="btn btn-danger rounded-pill px-4" @onclick="HandleLogout">Logout</button>
                        </div>
                    }

                    @if (!isUserAuthenticated)
                    {
                        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" for="email">Email Address</label>
                                <InputText id="email" class="form-control form-control-lg bg-light border-0" @bind-Value="registerModel.Email" placeholder="name@example.com" />
                                <ValidationMessage For="() => registerModel.Email" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" for="password">Password</label>
                                <InputText id="password" type="password" class="form-control form-control-lg bg-light border-0" @bind-Value="registerModel.Password" placeholder="••••••••" />
                                <ValidationMessage For="() => registerModel.Password" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-muted fw-semibold" for="confirmPassword">Confirm Password</label>
                                <InputText id="confirmPassword" type="password" class="form-control form-control-lg bg-light border-0" @bind-Value="registerModel.ConfirmPassword" placeholder="••••••••" />
                                <ValidationMessage For="() => registerModel.ConfirmPassword" class="text-danger small mt-1" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill fw-bold" disabled="@isSubmitting">
                                @(isSubmitting ? "Registering..." : "Create Account")
                            </button>
                        </EditForm>

                        <div class="text-center mt-4">
                            <p class="text-muted small">Already have an account? <a href="/login" class="text-decoration-none fw-bold">Log in here</a></p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new RegisterModel();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting;
    private bool isUserAuthenticated;

    protected override void OnInitialized()
    {
        isUserAuthenticated = !string.IsNullOrEmpty(UserStateService.Email) && !UserStateService.IsExpired();
        UserStateService.OnStateChanged += OnUserStateChanged;
    }

    private void OnUserStateChanged()
    {
        isUserAuthenticated = !string.IsNullOrEmpty(UserStateService.Email) && !UserStateService.IsExpired();
        StateHasChanged();
    }

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var result = await AuthService.RegisterAsync(registerModel);
            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                successMessage = "Registration successful! Redirecting to setup...";
                await Task.Delay(1500);
                // Changed from "/" to "/complete-profile"
                NavigationManager.NavigateTo("/complete-profile");
            }
            else
            {
                errorMessage = "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        isUserAuthenticated = false;
        successMessage = "You have been logged out.";
    }

    void IDisposable.Dispose()
    {
        UserStateService.OnStateChanged -= OnUserStateChanged;
    }
}