<div class="card profile-card shadow-sm">
    <div class="card-body text-center">
        <img src="@(string.IsNullOrWhiteSpace(ImageUrl) ? DefaultImage : ImageUrl)"
             alt="Profile image of @Name"
             class="profile-avatar mb-3" />
        <h5 class="card-title mb-2">@Name</h5>
        <p class="card-text text-muted">@Bio</p>
    </div>
</div>

@code {
    private const string DefaultImage = "https://via.placeholder.com/150";

    [Parameter] public string? Name { get; set; } = "Unknown User";
    [Parameter] public string? Bio { get; set; } = "No bio available.";
    [Parameter] public string? ImageUrl { get; set; }
}